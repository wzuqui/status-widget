{
  "name": "status-electron",
  "version": "1.0.0",
  "private": true,
  "description": "Always-on-top Electron status widget for Claude and Codex usage.",
  "author": "Willian Luis Zuqui",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win msi"
  },
  "build": {
    "appId": "com.ustudio.statuswidget",
    "productName": "Status Widget",
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "dist/**/*",
      "src/index.html",
      "src/styles.css",
      "src/config.html",
      "package.json"
    ],
    "extraResources": [
      "icone.png"
    ],
    "win": {
      "icon": "icone.png",
      "target": "msi",
      "signAndEditExecutable": false
    },
    "linux": {
      "icon": "icone.png",
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.2"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.8.3"
  }
}
