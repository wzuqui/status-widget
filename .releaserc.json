{
  "branches": [
    "main"
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist-release/*.msi",
            "label": "Status Widget Windows x64 (MSI)"
          },
          {
            "path": "dist-release/*.AppImage",
            "label": "Status Widget Linux x64 (AppImage)"
          }
        ]
      }
    ]
  ]
}
